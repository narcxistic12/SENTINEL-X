# ==============================================================================
# SENTINELX Environment Variables
# ==============================================================================
# Note: SENTINELX works out of the box with zero paid APIs or databases.
# Any unconfigured external threat intelligence providers will honestly report
# "Not configured" in the analysis coverage breakdown.

# Application URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Database (PostgreSQL / Neon / Supabase) for server-side persistence
# If not provided, SENTINELX automatically uses client-side persistent storage.
# DATABASE_URL="postgresql://user:password@host:5432/sentinelx?sslmode=require"

# Optional: Google Safe Browsing API v4
# https://developers.google.com/safe-browsing/v4
# GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Optional: VirusTotal API v3
# https://www.virustotal.com/gui/user/apiKey
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Optional: URLhaus API Auth Key (URLhaus supports free public querying even without key)
# https://urlhaus.abuse.ch/api/
# URLHAUS_API_KEY=your_urlhaus_api_key_here

# Optional: PhishTank API Key
# Required to enable PhishTank threat intel integration. Request at https://phishtank.org/developer_info.php
# PHISHTANK_API_KEY=your_phishtank_api_key

# Optional: urlscan.io API Key
# Enables real web page rendering, DOM form analysis, and screenshot metadata.
# Request key at https://urlscan.io/user/profile/
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=private

# Optional: ANY.RUN Sandbox API Key
# Enables interactive behavioral malware sandbox analysis. Request at https://any.run/
ANYRUN_API_KEY=

# Optional: Cloudflare URL Scanner API
# Enables real-time browser scanning via Cloudflare Radar. Request token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_URLSCANNER_API_TOKEN=
CLOUDFLARE_URLSCAN_VISIBILITY=unlisted

# Optional: URLScans API Key
# Enables real-time URL threat scanning & WHOIS analysis. Request at https://urlscans.com/api
URLSCANS_API_KEY=

# Optional: VirusTotal Fresh Analysis TTL (Minutes)
# Controls cache expiration for fresh URL submissions on VirusTotal.
VIRUSTOTAL_FRESH_SCAN_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# Rate Limiting & Performance
# -----------------------------------------------------------------------------

# Optional: Upstash Redis for distributed rate limiting across serverless edge nodes.
# If omitted, SentinelX falls back to a purely local, in-memory sliding window limiter.
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Control the default rate limits (Window in MS, Max Requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=25
